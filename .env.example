# Public site URL. Drives canonical/hreflang, sitemap, robots, OG/Twitter and JSON-LD
# absolute URLs. Set this to your real domain before a production build/generate — the
# `https://example.com` placeholder is always rejected. In development it falls back to
# http://localhost:3000 automatically.
NUXT_PUBLIC_SITE_URL=https://your-domain.com

# Web3Forms access key (public; required for the contact form in the modal)
NUXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Google Analytics 4 measurement ID, format G-XXXXXXXXXX. Empty (default) disables analytics.
# gtag.js loads in production builds only.
NUXT_PUBLIC_GA_MEASUREMENT_ID=
